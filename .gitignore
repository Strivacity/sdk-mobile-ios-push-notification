# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Xcode — per-user state (never share; breaks on other machines)
# ---------------------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.perspectivev3
*.mode1v3
*.mode2v3
*.pbxuser

# Shared schemes ARE committed on purpose (CI needs them):
#   *.xcworkspace/xcshareddata/xcschemes/
#   *.xcodeproj/xcshareddata/xcschemes/

# ---------------------------------------------------------------------------
# Build products / derived data
# ---------------------------------------------------------------------------
build/
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcresult/
*.o
*.a
*.dylib

# ---------------------------------------------------------------------------
# Swift Package Manager
# ---------------------------------------------------------------------------
.build/
Packages/

# Generated by `swift package generate-xcodeproj` — not authored here.
*.xcodeproj

# SwiftPM's per-package scratch dir: keep shared schemes, drop machine state.
**/.swiftpm/configuration/registries.json
**/.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
**/.swiftpm/xcode/xcuserdata/

# Package.resolved is deliberately NOT ignored: it pins dependency versions for
# CI. Consumers of this package ignore it, so it costs them nothing.

# ---------------------------------------------------------------------------
# Documentation output (DocC)
# ---------------------------------------------------------------------------
*.doccarchive
.docc-build/

# ---------------------------------------------------------------------------
# Credentials / local config
# ---------------------------------------------------------------------------
.netrc
*.p8
*.p12
*.mobileprovision
*.certSigningRequest
.env
.env.local
